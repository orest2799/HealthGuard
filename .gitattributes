# Normalize line endings to LF in the repo
* text=auto eol=lf

# Scripts and Gradle wrapper should always use LF
gradlew text eol=lf
*.sh text eol=lf

# Binary files - don't modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.jar binary
*.keystore binary
*.aab binary
*.apk binary
