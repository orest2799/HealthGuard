<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="24dp"
    android:gravity="top|center_horizontal">

    <Space
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <TextView
        android:id="@+id/tvAlarmLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pill Alarm"
        android:textColor="#B8B8BE"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAlarmTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="08:25"
        android:textColor="#FFFFFF"
        android:textSize="88sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMedicineName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Amoxicillin"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDosage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="500mg • 1 pill"
        android:textColor="#B8B8BE"
        android:textSize="20sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#F5A000"
        android:text="Snooze"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="28sp" />

    <Button
        android:id="@+id/btnTaken"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#2A2A2E"
        android:text="Taken"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="28sp" />

</LinearLayout>