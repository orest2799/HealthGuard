package app.meds

import org.jsoup.Jsoup
import org.jsoup.nodes.Document
import org.jsoup.nodes.Element
import java.net.URLEncoder
import java.nio.charset.StandardCharsets
import java.time.Duration
import kotlin.math.max

/**
 * Provider that searches and scrapes Galinos.gr directly
 * WITHOUT using DuckDuckGo (which blocks bots with CAPTCHA)
 */
class GalinosProvider(
    private val userAgent: String = DEFAULT_UA,
    private val connectTimeout: Duration = Duration.ofSeconds(12),
    private val readTimeout: Duration = Duration.ofSeconds(20),
    private val maxBodyChars: Int = 10_000
) {

    data class GalinosHit(
        val query: String,
        val matchedTitle: String? = null,
        val url: String? = null,
        val sections: Map<String, String> = emptyMap()
    )

    companion object {
        private const val DEFAULT_UA =
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 " +
                    "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

        private val TARGET_SECTION_HINTS = listOf(
            "Î•Î½Î´ÎµÎ¯Î¾ÎµÎ¹Ï‚",
            "Î”Î¿ÏƒÎ¿Î»Î¿Î³Î¯Î±",
            "Î‘Î½Ï„ÎµÎ½Î´ÎµÎ¯Î¾ÎµÎ¹Ï‚",
            "Î ÏÎ¿ÎµÎ¹Î´Î¿Ï€Î¿Î¹Î®ÏƒÎµÎ¹Ï‚",
            "Î‘Î»Î»Î·Î»ÎµÏ€Î¹Î´ÏÎ¬ÏƒÎµÎ¹Ï‚",
            "Î‘Î½ÎµÏ€Î¹Î¸ÏÎ¼Î·Ï„ÎµÏ‚ ÎµÎ½Î­ÏÎ³ÎµÎ¹ÎµÏ‚",
            "ÎšÏ…Î¿Ï†Î¿ÏÎ¯Î±",
            "Î“Î±Î»Î¿Ï…Ï‡Î¯Î±",
            "Î¥Ï€ÎµÏÎ´Î¿ÏƒÎ¿Î»Î¿Î³Î¯Î±",
            "Î¦Î±ÏÎ¼Î±ÎºÎ¿Î´Ï…Î½Î±Î¼Î¹ÎºÎ®",
            "Î¦Î±ÏÎ¼Î±ÎºÎ¿ÎºÎ¹Î½Î·Ï„Î¹ÎºÎ®",
        )

        private val KNOWN_MEDICINES = mapOf(
            "depon" to "https://www.galinos.gr/web/drugs/main/substances/paracetamol",
            "paracetamol" to "https://www.galinos.gr/web/drugs/main/substances/paracetamol",
            "augmentin" to "https://www.galinos.gr/web/drugs/main/substances/amoxicillin-clavulanic_acid",
            "aspirin" to "https://www.galinos.gr/web/drugs/main/substances/acetylsalicylic_acid",
            "ponstan" to "https://www.galinos.gr/web/drugs/main/substances/mefenamic_acid",
        )
    }

    fun searchSingle(query: String): GalinosHit {
        val cleanQuery = query.trim().lowercase()

        val knownUrl = KNOWN_MEDICINES[cleanQuery]
        if (knownUrl != null) {
            return fetchAndParse(query, knownUrl)
        }

        val searchUrl = findGalinosUrlDirect(cleanQuery)
        if (searchUrl != null) {
            return fetchAndParse(query, searchUrl)
        }

        val likelyUrl = "https://www.galinos.gr/web/drugs/main/substances/${cleanQuery.replace(" ", "_")}"
        val directAttempt = fetchAndParse(query, likelyUrl)
        if (directAttempt.url != null && directAttempt.sections.isNotEmpty()) {
            return directAttempt
        }

        return GalinosHit(
            query = query,
            matchedTitle = null,
            url = null,
            sections = emptyMap()
        )
    }

    private fun findGalinosUrlDirect(query: String): String? {
        val substanceUrl = "https://www.galinos.gr/web/drugs/main/substances/${query.replace(" ", "_")}"

        try {
            val doc = Jsoup.connect(substanceUrl)
                .userAgent(userAgent)
                .timeout(connectTimeout.toMillis().toInt())
                .get()

            if (doc.body().text().isNotBlank()) {
                return substanceUrl
            }
        } catch (_: Throwable) {
        }

        try {
            val searchUrl = "https://www.galinos.gr/web/drugs/main/search?term=${URLEncoder.encode(query, StandardCharsets.UTF_8)}"
            val doc = Jsoup.connect(searchUrl)
                .userAgent(userAgent)
                .timeout(connectTimeout.toMillis().toInt())
                .get()

            val firstLink = doc.select("a[href*='/web/drugs/']").firstOrNull()
            if (firstLink != null) {
                val href = firstLink.absUrl("href")
                if (href.isNotBlank()) {
                    return href
                }
            }
        } catch (_: Throwable) {
        }

        return null
    }

    private fun fetchAndParse(query: String, url: String): GalinosHit {
        val doc = fetch(url) ?: return GalinosHit(query, url = null)

        val title = doc.title().orEmpty().trim().ifBlank { null }
        val sections = extractSections(doc)

        return GalinosHit(
            query = query,
            matchedTitle = title,
            url = url,
            sections = sections
        )
    }

    private fun fetch(url: String): Document? = try {
        Jsoup.connect(url)
            .userAgent(userAgent)
            .timeout(connectTimeout.toMillis().toInt())
            .get()
    } catch (_: Throwable) {
        null
    }

    private fun extractSections(doc: Document): Map<String, String> {
        val container: Element = doc.selectFirst("article,main,.content,.container,.page-content,body") ?: doc.body()

        val rawSections = LinkedHashMap<String, StringBuilder>()
        var currentTitle = "Î Î»Î·ÏÎ¿Ï†Î¿ÏÎ¯ÎµÏ‚"

        fun pushText(text: String) {
            if (text.isBlank()) return
            rawSections.getOrPut(currentTitle) { StringBuilder() }
                .apply {
                    if (isNotEmpty()) append("\n\n")
                    append(text)
                }
        }

        for (el in container.allElements) {
            val tag = el.tagName().lowercase()
            when (tag) {
                "h1", "h2", "h3", "h4" -> {
                    val title = el.text().clean()
                    if (title.isNotBlank()) {
                        currentTitle = title
                        rawSections.putIfAbsent(currentTitle, StringBuilder())
                    }
                }
                "p", "li", "td", "div" -> {
                    val text = el.ownText().clean()
                    if (text.isNotBlank() && text.length < maxBodyChars) {
                        pushText(text)
                    }
                }
            }
        }

        val all = rawSections.mapValues { (_, sb) ->
            sb.toString().trim().take(maxBodyChars)
        }.filterValues { it.isNotBlank() }

        if (all.isEmpty()) return emptyMap()

        val scored = all.entries.map { (k, v) ->
            val score = sectionNameScore(k)
            k to Pair(score, v)
        }

        val byBest = LinkedHashMap<String, String>()

        for (hint in TARGET_SECTION_HINTS) {
            val best = scored
                .filter { (title, _) -> title.contains(hint, ignoreCase = true) }
                .maxByOrNull { it.second.first }
            if (best != null) byBest[hint] = best.second.second
        }

        if (byBest.isEmpty()) {
            val top = scored.sortedByDescending { it.second.first }.take(3)
            for ((title, pair) in top) {
                byBest[title] = pair.second
            }
        }

        return byBest
    }

    private fun sectionNameScore(title: String): Int {
        val t = title.lowercase()
        var s = 0
        for (hint in TARGET_SECTION_HINTS) {
            if (t.contains(hint.lowercase())) {
                s += max(1, hint.length / 3)
            }
        }
        return s
    }

    private fun String.clean(): String =
        this.replace(Regex("\\s+"), " ").trim()
}
